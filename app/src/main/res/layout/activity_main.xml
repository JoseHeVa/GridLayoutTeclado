<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvPantalla"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="28sp"
        android:gravity="end"
        android:padding="16dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="16dp" />

    <!-- Cuadrícula de 3 columnas x 5 filas -->
    <GridLayout
        android:id="@+id/gridTeclado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="5"
        android:useDefaultMargins="true">

        <Button android:text="1" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />
        <Button android:text="2" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />
        <Button android:text="3" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />

        <Button android:text="4" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />
        <Button android:text="5" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />
        <Button android:text="6" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />

        <Button android:text="7" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />
        <Button android:text="8" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />
        <Button android:text="9" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />

        <Button android:text="C" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />
        <Button android:text="0" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />
        <Button android:text="⌫" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="4dp" />

        <Button
            android:text="Aceptar"
            android:layout_columnSpan="3"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="4dp"
            android:id="@+id/btnAceptar" />

    </GridLayout>

</LinearLayout>
